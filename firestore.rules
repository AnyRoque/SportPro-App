rules_version = '2';

// Reglas de seguridad de SportPro (Cloud Firestore)
// Publicar en: Firebase Console > Firestore Database > Reglas
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(myDoc()) ? get(myDoc()).data.role : ''; }
    function isAdmin() { return signedIn() && role() == 'ADM'; }
    function isDt() { return signedIn() && role() == 'DT'; }

    // ---------- Usuarios (US-01, US-06) ----------
    match /users/{uid} {
      allow read: if signedIn();
      // Registro público: solo DT, JUG o PAD. El ADM solo lo crea otro ADM (US-06).
      allow create: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role in ['DT', 'JUG', 'PAD'])
                    || isAdmin();
      // Nadie puede cambiar su propio rol ni reactivarse
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active)
                    || isAdmin();
      allow delete: if false;
    }

    // ---------- Administradores (US-06): solo ADM ----------
    match /Admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ---------- Equipos (US-03, US-07) ----------
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if isDt()
                    && request.resource.data.dtUid == request.auth.uid
                    && request.resource.data.status == 'PENDIENTE';
      // El DT edita su equipo sin poder aprobarlo; el ADM aprueba o rechaza
      allow update: if isAdmin()
                    || (isDt() && resource.data.dtUid == request.auth.uid
                        && (request.resource.data.status == resource.data.status
                            || request.resource.data.status == 'PENDIENTE'));
      allow delete: if isAdmin();
    }

    // ---------- Partidos y eventos en vivo (US-16 a US-21) ----------
    match /matches/{matchId} {
      allow read, write: if signedIn();
      match /callups/{callUpId} { allow read, write: if signedIn(); }
      match /lineup/{lineupId} { allow read, write: if signedIn(); }
      match /events/{eventId} {
        allow read, create, update: if signedIn();
        allow delete: if false;   // los eventos se anulan, no se borran (US-20)
        match /history/{historyId} {
          allow read, create: if signedIn();
          allow update, delete: if false;   // bitácora inmutable
        }
      }
    }

    // ---------- Anuncios (US-22) ----------
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if (isAdmin() || isDt()) && request.resource.data.authorUid == request.auth.uid;
      // El autor edita; cualquiera con sesión solo puede marcarlo como leído
      allow update: if (signedIn() && resource.data.authorUid == request.auth.uid)
                    || isAdmin()
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    // ---------- Comunidad (US-23) y moderación (US-24) ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'VISIBLE';
      allow update: if isAdmin()
                    // El autor puede eliminar (marcar ELIMINADO) su publicación
                    || (signedIn() && resource.data.authorUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions', 'commentCount', 'reportCount']))
                    // Los demás: reaccionar, comentar, reportar (3 reportes la ocultan)
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount', 'reportCount', 'status'])
                        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'OCULTO'));
      allow delete: if false;   // nunca se borran físicamente
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
        allow update: if false;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      // get de un id inexistente (para evitar doble reporte) también se permite
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- Resumen IA del partido (US-25 a US-27) ----------
    match /summaries/{matchId} {
      allow read: if signedIn();
      allow create, update: if isDt();
      allow delete: if false;
    }

    // ---------- Jugadores, entrenamientos y notificaciones ----------
    // Requieren sesión. Pendiente: restringir por rol en la siguiente iteración.
    match /{col}/{docId=**} {
      allow read, write: if signedIn() && col in [
        'players', 'dniIndex', 'trainings', 'attendance', 'attendanceHistory',
        'notifications', 'eventCancellationRequests'
      ];
    }
  }
}
