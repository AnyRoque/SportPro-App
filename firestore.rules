rules_version = '2';

// Reglas de seguridad de SportPro (Cloud Firestore)
// Publicar en: Firebase Console > Firestore Database > Reglas
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---------- Administradores Autorizados ----------
    match /Admins/{adminId} {
      allow read, write: if signedIn();
    }
    match /Administradores/{adminId} {
      allow read, write: if signedIn();
    }

    // ---------- Usuarios (US-01, US-06) ----------
    match /users/{uid} {
      allow read, create, update: if signedIn();
    }

    // ---------- Equipos (US-03, US-07) ----------
    match /teams/{teamId} {
      allow read, create, update, delete: if signedIn();
    }

    // ---------- Jugadores (US-02, US-04) ----------
    match /players/{playerId} {
      allow read, create, update, delete: if signedIn();
    }

    // ---------- Partidos y Eventos en Vivo (US-16 a US-21) ----------
    match /matches/{matchId} {
      allow read, create, update, delete: if signedIn();

      match /callups/{callUpId} {
        allow read, create, update, delete: if signedIn();
      }

      match /lineup/{lineupId} {
        allow read, create, update, delete: if signedIn();
      }

      match /events/{eventId} {
        allow read, create, update, delete: if signedIn();

        match /history/{historyId} {
          allow read, create: if signedIn();
          allow update, delete: if false;
        }
      }
    }

    // ---------- Notificaciones ----------
    match /notifications/{notifId} {
      allow read, create, update, delete: if signedIn();
    }

    // ---------- Índice de DNI ----------
    match /dniIndex/{dni} {
      allow read, get, create, update: if signedIn();
    }
  }
}
